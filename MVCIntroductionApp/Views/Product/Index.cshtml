@model WrapperVM

<ul>
  <li>Item 1</li>
  <li>Item 2</li>
</ul>


<h1>Ürünler</h1>
<ul>
  @foreach (var item in Model.Products)
  {
    <li>@item.Name - @item.Price</li>
  }
</ul>

<h1>Kategoriler</h1>
<div>
  @foreach (var item in Model.Categories)
  {
    <div>@item.Name</div>
  }
</div>

<button onclick="SendDataToServer()">SendDataToServer</button>

@* Scriptler ile çalışmak için section Script içine scriptleri yazalım ki Layout daki akış bozulmasın *@

@section Scripts {
  <script>
    $(document).ready(() => {
       alert("Jquery Yüklendi");

       // javascript c# etkileşimi
       // C# nesnelerini javascript nesnelerine dönüştürmeliyiz.
       const items = @Html.Raw(Json.Serialize(Model.Products))
       console.log("items", items);


    })


    function SendDataToServer() {

      const items = @Html.Raw(Json.Serialize(Model.Products))

      $.ajax({
        method:'Post',
        contentType: 'application/json; charset=utf-8', // veriyi gönderirken contentType girelim.
        dataType: 'json',
        data: JSON.stringify(items), // veriyi Json Stringify yapalım
        url:'/Product/SendJsonData',
        success:(response) => {
           console.log('response', response);
        },
        error:(xhr, status, err) => {
          console.log('err', xhr.responseText || err);
        }
      })
    }

  </script>
}

