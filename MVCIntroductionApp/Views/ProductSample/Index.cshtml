@model List<MVCIntroductionApp.Models.ProductDto>
@using System.Globalization
@{
    ViewData["Title"] = "Ürünler";
    var search = ViewData["Search"] as string ?? string.Empty;
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var tr = new CultureInfo("tr-TR");
}


<section class="py-4">
  

<!--Sadece değişecek olan dinamik content id="content" ile güncelledik. Form search kısmını partiview ile hesaplayıp yeniden render edince input event listener remove olduğundan search çalışmıyordu.-->

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
<div></div>
  <form method="get" asp-action="Index" class="w-100" style="max-width: 420px;" role="search">
            <label for="product-search" class="visually-hidden">Ürün ara</label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true">&#128269;</span>
                <input id="product-search"
                       type="search"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Ürün adına göre ara..."
                       autocomplete="off" />
                <button class="btn btn-primary" type="submit">Ara</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index", "ProductSample")">Temizle</a>
                }
            </div>
        </form>
      </div>

    <div id="content">
     @{ await Html.RenderPartialAsync("PartialViews/ProductListPartialView", Model); }
   </div>

</section>


@section Scripts {

  <script>
  

  $(document).ready(() => {
  
       // input search edildiğinde
      $('#product-search').on('input', function () {
        // $(this) -> o anki element
          const searchValue = $(this).val().trim();
         

            console.log('searchValue', searchValue);

          if (searchValue.length > 0) {

            $(this).siblings('a').show();
        
          } else {
             $(this).siblings('a').hide();
          }

          if (searchValue.length > 3 || searchValue.length == 0) {

           $.ajax({
                method:'GET',
                url:`/ProductSample/ProductListPartialView?search=${searchValue}`,
                contentType:'application/json',
                success:(response => {
                  console.log('response',response);
                  $('#content').empty();
                  $('#content').html(response);
                }),
                error:(err => {
                  console.log('err',err);
                })
            })

            }

      });

  })





  </script>


}